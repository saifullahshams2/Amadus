            {
              "id": "strix-coverage/dangerous-sink-usage-eval-system-exec-proc-open-unserialize-file-writes-raw-sql",
              "name": "Dangerous sink usage (eval, system, exec, proc_open, unserialize, file writes, raw SQL)",
              "shortDescription": {
                "text": "Coverage: Dangerous sink usage (eval, system, exec, proc_open, unserialize, file writes, raw SQL)"
              },
              "fullDescription": {
                "text": "Coverage of Dangerous sink usage (eval, system, exec, proc_open, unserialize, file writes, raw SQL) across the assessed attack surface."
              },
              "defaultConfiguration": {
