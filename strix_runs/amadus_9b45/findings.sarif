          "ruleId": "CWE-639",
          "ruleIndex": 4,
          "level": "note",
          "message": {
            "text": "Any instructor can delete any office's scenario and cascade-delete its student submissions\n\nAny instructor can delete any scenario in the database regardless of which office created it, and the deletion cascades to every student's graded submissions for that scenario. Scenario deletion has an instructor role check but no ownership or office check, unlike every other instructor object operation in the application."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/Http/Controllers/DashboardController.php"
                },
                "region": {
                  "startLine": 456,
