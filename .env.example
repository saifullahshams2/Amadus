# Database Configuration
# Supported types: 'sqlite' (default, zero-config) or 'postgres'
DATABASE_TYPE=sqlite

# For SQLite: Path to the SQLite DB file (default: file:./data/gds.db)
# For PostgreSQL: e.g. postgresql://postgres:password@localhost:5432/gds_amadeus
DATABASE_URL=file:./data/gds.db

# Authentication
JWT_SECRET=gds-amadeus-simulator-secret-key-2026

# Server Port (optional, defaults to 3000)
PORT=3000
